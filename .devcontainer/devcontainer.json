{
  "name": "My-ISN — Preview Web (Flutter)",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "remoteUser": "cirrus",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Preview Aplikasi My-ISN (Flutter web)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "flutter pub get",
  "postAttachCommand": "flutter run -d web-server --web-hostname 0.0.0.0 --web-port 8080",
  "customizations": {
    "vscode": {
      "extensions": ["Dart-Code.dart-code", "Dart-Code.flutter"],
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter"
      }
    }
  }
}
